{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-lens.local/schemas/source-manifest.schema.json",
  "title": "Sovereign Lens source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "retrieved_at", "selection_method", "sources"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^case_[a-z0-9_]+$" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "selection_method": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title", "publisher", "published_at", "source_type", "perspective", "language", "relevance", "acquisition"],
      "properties": {
        "id": { "type": "string", "pattern": "^src_[a-z0-9_]+$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "published_at": { "type": ["string", "null"], "format": "date" },
        "source_type": { "type": "string", "enum": ["company_announcement", "company_policy", "government_statement", "regulatory_statement", "legislative_record", "government_analysis", "development_finance", "civil_society", "news_report", "research"] },
        "perspective": { "type": "string", "enum": ["participant", "government_participant", "development_funder", "civil_society", "regulator", "oversight", "analytical_overview", "independent_reporting", "independent_research"] },
        "language": { "type": "string", "pattern": "^[a-z]{2}$" },
        "relevance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acquisition": { "type": "string", "enum": ["direct_url", "api", "manual_upload"] },
        "notes": { "type": "string" }
      }
    }
  }
}
