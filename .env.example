# Copy this file to .env and add only the providers you plan to run.
# .env is gitignored. Never put real credentials in this example file.

# Core MVP panel
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Expanded/challenger panel
XAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Optional regional/open-model hosting
HF_TOKEN=
GIGACHAT_CREDENTIALS=

# Optional model overrides. Defaults live in config/providers.json.
OPENAI_MODEL=
QWEN_MODEL=
MISTRAL_MODEL=
ANTHROPIC_MODEL=
XAI_MODEL=
GEMINI_MODEL=
DEEPSEEK_MODEL=
ZAI_MODEL=

# Optional endpoint/region overrides. Do not change these casually: hosting region
# is evaluation metadata and can affect both availability and provider policy.
DASHSCOPE_BASE_URL=
ZAI_BASE_URL=
SELF_HOSTED_BASE_URL=
SELF_HOSTED_API_KEY=
SELF_HOSTED_MODEL=

# Optional partner adapters. The micro demo runs without credentials.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
STASH_API_KEY=
COFRAME_SITE_ID=
